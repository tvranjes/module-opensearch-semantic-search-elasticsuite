<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="inchoodev_opensearch_semantic_search">
            <group id="elasticsuite" translate="label" type="text" sortOrder="50"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Elasticsuite</label>
                <field id="autocomplete_enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Semantic Ranking In Autocomplete</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>
                        Applies the hybrid ranking to the product suggestions of the search box as well.
                        Every suggestion request then costs one model inference and one candidate query;
                        set to No to keep autocomplete on plain Elasticsuite ranking.
                    </comment>
                </field>
            </group>
        </section>
    </system>
</config>
